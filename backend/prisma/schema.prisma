generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  passwordHash     String
  fullName         String
  role             UserRole
  currentLocation  String?
  createdAt        DateTime  @default(now())
  assignedMissions Mission[] @relation("AdminAssignments")
  missions         Mission[] @relation("VolunteerMissions")
}

model Incident {
  id           Int          @id @default(autoincrement())
  rawMessage   String
  aiAddress    String?
  geomLocation String?
  urgencyLevel String
  needs        Json
  status       RescueStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  aiLogs       AILog[]
  missions     Mission[]
}

model Mission {
  id            Int           @id @default(autoincrement())
  incidentId    Int
  volunteerId   Int
  assignedById  Int
  missionStatus MissionStatus @default(EN_ROUTE)
  startedAt     DateTime?
  completedAt   DateTime?
  assignedBy    User          @relation("AdminAssignments", fields: [assignedById], references: [id])
  incident      Incident      @relation(fields: [incidentId], references: [id])
  volunteer     User          @relation("VolunteerMissions", fields: [volunteerId], references: [id])
}

model AILog {
  id            Int      @id @default(autoincrement())
  incidentId    Int
  promptVersion String
  rawResponse   String
  isParsed      Boolean  @default(false)
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  incident      Incident @relation(fields: [incidentId], references: [id])
}

model RescueRequest {
  id                  Int          @id @default(autoincrement())
  rawText             String
  aiExtractedAddress  Json?
  aiUrgency           String?
  aiNeeds             Json?
  aiContact           String?
  geomLocation        String?
  geocodingConfidence Float?
  status              RescueStatus @default(PENDING)
  createdAt           DateTime     @default(now())
}

model AIPipelineLog {
  id               Int      @id @default(autoincrement())
  requestId        Int
  promptVersion    String
  rawLlmResponse   String
  parseSuccess     Boolean  @default(false)
  retryCount       Int      @default(0)
  edgeCaseFlags    Json?
  processingTimeMs Int?
  createdAt        DateTime @default(now())
}

model HotspotCluster {
  clusterId      Int      @id @default(autoincrement())
  centerGeom     String
  totalRequests  Int
  redCount       Int
  clusterPolygon String?
  createdAt      DateTime @default(now())
}

enum UserRole {
  ADMIN
  VOLUNTEER
  CITIZEN
}

enum MissionStatus {
  EN_ROUTE
  ON_SITE
  DONE
}

enum RescueStatus {
  PENDING
  ASSIGNED
  COMPLETED
}
