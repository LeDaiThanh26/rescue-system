generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VOLUNTEER
  CITIZEN
}

enum MissionStatus {
  EN_ROUTE
  ON_SITE
  DONE
}

enum RescueStatus {
  PENDING
  ASSIGNED
  COMPLETED
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  passwordHash    String
  fullName        String
  role            UserRole
  currentLocation String?

  missions        Mission[] @relation("VolunteerMissions")
  assignedMissions Mission[] @relation("AdminAssignments")

  createdAt       DateTime  @default(now())
}

model Incident {
  id            Int       @id @default(autoincrement())
  rawMessage    String
  aiAddress     String?
  geomLocation  String?
  urgencyLevel  String
  needs         Json
  status        RescueStatus @default(PENDING)

  missions      Mission[]
  aiLogs        AILog[]

  createdAt     DateTime @default(now())
}

model Mission {
  id            Int            @id @default(autoincrement())

  incidentId    Int
  volunteerId   Int
  assignedById  Int

  missionStatus MissionStatus @default(EN_ROUTE)

  startedAt     DateTime?
  completedAt   DateTime?

  incident       Incident @relation(fields: [incidentId], references: [id])

  volunteer      User @relation("VolunteerMissions", fields: [volunteerId], references: [id])

  assignedBy     User @relation("AdminAssignments", fields: [assignedById], references: [id])
}

model AILog {
  id            Int      @id @default(autoincrement())

  incidentId    Int

  promptVersion String
  rawResponse   String

  isParsed      Boolean  @default(false)

  retryCount    Int      @default(0)

  incident      Incident @relation(fields: [incidentId], references: [id])

  createdAt     DateTime @default(now())
}

model RescueRequest {
  id                    Int      @id @default(autoincrement())

  rawText               String

  aiExtractedAddress    Json?
  aiUrgency             String?

  aiNeeds               Json?

  aiContact             String?

  geomLocation          String?

  geocodingConfidence   Float?

  status                RescueStatus @default(PENDING)

  createdAt             DateTime @default(now())
}

model AIPipelineLog {
  id              Int      @id @default(autoincrement())

  requestId       Int

  promptVersion   String

  rawLlmResponse  String

  parseSuccess    Boolean  @default(false)

  retryCount      Int      @default(0)

  edgeCaseFlags   Json?

  processingTimeMs Int?

  createdAt       DateTime @default(now())
}

model HotspotCluster {
  clusterId       Int      @id @default(autoincrement())

  centerGeom      String

  totalRequests   Int

  redCount        Int

  clusterPolygon  String?

  createdAt       DateTime @default(now())
}